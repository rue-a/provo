@prefix ex: <http://example.org#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:bar_chart a prov:Entity ;
    rdfs:label "Bar Chart"@en ;
    prov:wasAttributedTo ex:derek ;
    prov:wasDerivedFrom ex:aggregatedByRegions ;
    prov:wasGeneratedBy ex:illustrationActivity .

ex:civil_action_group a prov:Agent,
        foaf:Organization ;
    rdfs:label "Civil Action Group"@en .

ex:crimeData a prov:Entity ;
    rdfs:label "Crime Data"@en ;
    prov:wasAttributedTo ex:government .

ex:government a prov:Agent,
        foaf:Organization ;
    rdfs:label "Government"@en .

ex:illustrationActivity a prov:Activity ;
    rdfs:label "Illustration Activity"@en ;
    prov:used ex:aggregatedByRegions ;
    prov:wasAssociatedWith ex:derek ;
    prov:wasInformedBy ex:aggregationActivity .

ex:nationalRegionsList a prov:Entity ;
    rdfs:label "National Regions List"@en ;
    prov:wasAttributedTo ex:civil_action_group .

ex:national_newspaper_inc a prov:Agent,
        foaf:Organization ;
    rdfs:label "National Newspaper Inc."@en ;
    foaf:name "National Newspaper Inc."@en .

ex:aggregatedByRegions a prov:Entity ;
    rdfs:label "Aggregated by Regions"@en ;
    prov:wasAttributedTo ex:derek ;
    prov:wasGeneratedBy ex:aggregationActivity .

ex:aggregationActivity a prov:Activity ;
    rdfs:label "Aggregation Activity"@en ;
    prov:endedAtTime "2011-07-14T02:02:02"^^xsd:dateTime ;
    prov:startedAtTime "2011-07-14T01:01:01"^^xsd:dateTime ;
    prov:used ex:crimeData,
        ex:nationalRegionsList ;
    prov:wasAssociatedWith ex:derek .

ex:derek a prov:Agent,
        foaf:Person ;
    rdfs:label "Derek"@en ;
    prov:actedOnBehalfOf ex:national_newspaper_inc ;
    foaf:givenName "Derek"@en ;
    foaf:mbox <mailto:derek@example.org> .

